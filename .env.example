# Copie ce fichier en .env et modifie les valeurs.
# En production : ADMIN_USER, ADMIN_PASS et SYNC_SECRET (obligatoire).

PORT=3000
ADMIN_USER=Sramtwo
ADMIN_PASS=changez_moi_en_production
# Mot de passe pour le bouton « Sync serveur » du panel (même valeur à entrer dans le panel)
SYNC_SECRET=changez_moi_aussi
